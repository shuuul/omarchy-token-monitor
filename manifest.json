{
  "schemaVersion": 1,
  "id": "shuuul.token-monitor",
  "name": "Token Monitor",
  "version": "0.1.0",
  "author": "shuuul",
  "license": "MIT",
  "description": "Amp, Codex, Kimi Code, Cursor, Grok, Notion AI, Zed, and Droid quotas in the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Token Monitor",
    "description": "One bar meter and one panel: session, weekly, credits, and pace for the supported providers.",
    "category": "AI",
    "aliases": [
      "codexbar",
      "token monitor",
      "amp",
      "codex",
      "kimi",
      "cursor",
      "grok",
      "notion",
      "zed",
      "factory",
      "droid"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "browser": "chrome",
      "refreshIntervalSec": 300,
      "providers": {
        "amp": { "enabled": true },
        "codex": { "enabled": true },
        "kimi": { "enabled": true },
        "cursor": { "enabled": true },
        "grok": { "enabled": true },
        "notion": { "enabled": true },
        "zed": { "enabled": true },
        "factory": { "enabled": true }
      }
    },
    "schema": [
      {
        "key": "browser",
        "type": "enum",
        "label": "Browser cookies",
        "options": ["chrome", "chromium"],
        "defaultValue": "chrome",
        "description": "Read session cookies from this Chromium-based browser."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300,
        "description": "How often the panel polls every provider. Default 5 minutes."
      }
    ]
  }
}
